			"com.cpvphelper.CPvPHelper"
		]
	},
	"mixins": [
		"cpvphelper.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
